# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{jl,nu}]
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

# App-managed settings — must not be touched on save (see treefmt.toml excludes)
[{DankMaterialShell,devdocs}/*.json]
insert_final_newline = unset
trim_trailing_whitespace = unset

[Makefile]
indent_style = tab
