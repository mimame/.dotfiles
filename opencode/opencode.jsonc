{
  // opencode.jsonc: Configuration for the OpenCode AI agent.
  // Models & providers, agents, MCP gating, compaction, and permission rules.
  "$schema": "https://opencode.ai/config.json",

  // --- MODEL SELECTION ---
  // Cloud-first default: Qwen3.8 Flash (best coding/reasoning tier via opencode-go).
  // DeepSeek V4 Pro stays available as fallback (`opencode -m opencode-go/deepseek-v4-pro`).
  // GLM-5.2 stays wired to the `plan` agent for long-horizon precision work.
  // Local models (Ollama) remain fully configured and visible in /models:
  //   `opencode -m ollama-local/qwen3:14b`   (default local model)
  //   `opencode -m ollama-local/qwen3-coder:30b` (big MoE, close apps first)
  //   `opencode -m ollama-local/muse-glimmer:30b` (30B, ~18GB RAM)
  //   or use the `@local` agent.
  "model": "opencode-go/qwen3.8-flash",
  // small_model (titles, summaries) on the paid flash tier: cloud-backed (no Ollama
  // dependency) and far more reliable than the rate-limited free tier
  // (opencode/deepseek-v4-flash-free). Flash requests barely dent the quota.
  "small_model": "opencode-go/deepseek-v4-flash",

  // Never offer session sharing — dotfiles sessions can leak host paths/context.
  "share": "disabled",

  "provider": {
    // --- LOCAL PROVIDER ---
    // Ollama runs as a native daemon at localhost:11434. We use the OpenAI-compatible
    // endpoint (/v1) instead of Ollama's native API because opencode's SDK has better
    // tool-calling support and streaming reliability through the OpenAI interface.
    //
    // temperature: 0 is deliberate for ALL local models - deterministic outputs make
    // tool calls predictable, which is critical for local models that lack the
    // instruction-following quality of cloud models. Cloud models keep their defaults
    // (usually 0.7) because they're robust enough to handle variance.
    //
    // Context/output limits are conservative (32k/8k) to match what these models were
    // trained on and to avoid OOM errors on the 32GB Mac. Larger context = more RAM.
    "ollama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        // qwen3:14b - Daily driver for local work. Fast enough to keep apps open,
        // good enough for routine edits. ~8GB RAM. Use when you need local inference
        // but can't afford to close heavy apps.
        "qwen3:14b": {
          "name": "Qwen3 14B (Ollama)",
          "tool_call": true,
          "temperature": true,
          "options": {
            "temperature": 0
          },
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        // qwen3-coder:30b - Best local quality. MoE architecture, ~19GB RAM.
        // Close heavy apps (browsers, IDEs) before using. Reserved for complex
        // refactoring, multi-file changes, or when cloud quota is exhausted.
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B (Ollama, ~19GB RAM)",
          "tool_call": true,
          "temperature": true,
          "options": {
            "temperature": 0
          },
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        // qwen3.5:9b - Fastest local model, lowest quality. Kept as a local
        // small_model fallback (summarization, simple lookups). ~6GB RAM.
        // Not suitable for complex tool-calling workflows.
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B (Ollama)",
          "tool_call": true,
          "temperature": true,
          "options": {
            "temperature": 0
          },
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        // muse-glimmer:30b - Alternative 30B model, slightly smaller footprint (~18GB).
        // Kept as fallback if qwen3-coder:30b has issues or for A/B testing.
        // Similar quality, different training data.
        "muse-glimmer:30b": {
          "name": "Muse Glimmer 30B (Ollama, ~18GB RAM)",
          "tool_call": true,
          "temperature": true,
          "options": {
            "temperature": 0
          },
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },

  // --- AGENTS ---
  // Per-agent model pinning: cloud and local work get their own model/settings
  // instead of applying one configuration to everything.
  "agent": {
    // Plan mode = long-horizon precision -> GLM-5.2 (best agentic quality).
    "plan": {
      "model": "opencode-go/glm-5.2"
    },
    // Serious local work, zero cloud tokens. Default model: the 30B coder
    // (best local quality). Close heavy apps first (~19 GB RAM). Falls back to
    // 14B for daily use with apps open — override with opencode -m.
    "local": {
      "model": "ollama-local/qwen3-coder:30b",
      "temperature": 0,
      "description": "Use local Ollama Qwen3 Coder 30B (no cloud tokens)",
      // Primary-only: switch with Tab. As mode "all" it was advertised as a
      // task-invokable subagent, and local models hallucinate the name as a
      // direct tool call (invalid [tool=local]) instead of using task.
      "mode": "primary",
      // Local models (esp. the 30B) hallucinate subagent names (explore,
      // plan, general) as direct tools instead of calling task. Denying task
      // removes subagents from the Task tool description entirely, so the
      // model explores directly with read/glob/grep instead.
      "permission": {
        "task": "deny"
      },
      "prompt": "You are a self-contained local coding agent. Subagents are unavailable: never emit a tool call named explore, plan, general, or local. Explore the codebase yourself with read, glob, and grep."
    }
  },

  // --- MCP SERVERS ---
  // Model Context Protocol servers provide additional tools (package search, system
  // info, etc.). Both are DISABLED by default because each MCP adds ~2-3k tokens of
  // tool schemas to EVERY prompt, which measurably degrades tool-calling accuracy
  // for local models and increases cloud token costs.
  //
  // Enable on demand when you need specific MCP tools:
  //   brew: Package search/install for Homebrew (macOS)
  //   nixos: Package search for NixOS (Linux only)
  //
  // To enable temporarily, set "enabled": true and restart opencode.
  "mcp": {
    "brew": {
      "type": "local",
      "command": ["brew", "mcp-server"],
      "enabled": false,
      "timeout": 30000
    },
    // NixOS MCP only works on the NixOS machine. Re-enable there for package search.
    // On macOS, this will fail silently (nix command not found or wrong platform).
    "nixos": {
      "type": "local",
      "command": ["nix", "run", "github:utensils/mcp-nixos", "--"],
      "enabled": false,
      "timeout": 30000
    }
  },

  // --- COMPACTION ---
  // Context window management for long conversations. Auto-compaction summarizes
  // older turns to stay within model limits and reduce token costs.
  //
  // tail_turns: 3 - Keep the last 3 turns verbatim (unsummarized). Fewer than before
  // because cloud models handle compressed context better, and this saves tokens.
  //
  // reserved: 2048 - Reserve this many tokens for system prompts, tool schemas, and
  // safety margin. Prevents "context too long" errors at the edge of the limit.
  //
  // preserve_recent_tokens: 8000 - When compacting, keep the most recent 8k tokens
  // intact (roughly 4-5 turns). Balances context retention vs. compression ratio.
  // Lower than default to save cloud tokens on long sessions.
  "compaction": {
    "auto": true,
    "tail_turns": 3,
    "reserved": 2048,
    "preserve_recent_tokens": 8000
  },

  "permission": {
    "bash": {
      "*": "allow",
      // --- System ---
      "sudo*": "ask",
      "shutdown*": "deny",
      "reboot*": "deny",
      "halt*": "deny",
      "dd*": "deny",
      "mkfs*": "deny",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      // -f alone just suppresses the prompt (plain rm is allowed anyway) -> ask.
      "rm -f*": "ask",
      // Catch recursive deletes however the flags are spelled or ordered.
      // Must come after "rm -f*" so deny wins for combined cases (rm -f -r).
      "rm -r*": "deny",
      "rm * -r*": "deny",
      "rm --recursive*": "deny",
      "topgrade*": "ask",
      // --- Process management ---
      "pkill*": "ask",
      "killall*": "ask",
      // --- Git ---
      // Last matching rule wins: broad rules first, specific asks/denies after.
      "git commit*": "ask",
      "git push*": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push --force-with-lease*": "ask",
      "git merge*": "ask",
      "git rebase*": "ask",
      "git reset*": "ask",
      "git reset --hard*": "deny",
      "git checkout*": "ask",
      "git restore*": "ask",
      "git stash drop*": "ask",
      "git stash clear*": "ask",
      "git clean*": "ask",
      "git clean -fd*": "deny",
      "git clean -df*": "deny",
      "git clean -fdx*": "deny",
      "git clean -dx*": "deny",
      "git clean -xd*": "deny",
      "git clean -x*": "deny",
      // --- Docker ---
      "docker*": "allow",
      "docker run*": "ask",
      "docker rm*": "ask",
      "docker rmi*": "ask",
      "docker stop*": "ask",
      "docker kill*": "ask",
      "docker system prune*": "ask",
      // --- Brew ---
      "brew*": "allow",
      "brew remove*": "ask",
      "brew uninstall*": "ask",
      "brew autoremove*": "ask",
      // --- Nix ---
      // "nix*" also matches nixos-rebuild, so it must come first, not last.
      "nix*": "allow",
      "nix profile remove*": "ask",
      "nixos-rebuild*": "ask",
      "nix* delete*": "ask",
      // --- OpenTofu ---
      // Broad "ask" first; the specific allows below must come after it.
      "tofu*": "ask",
      "tofu init*": "allow",
      "tofu plan*": "allow",
      "tofu validate*": "allow",
      "tofu apply*": "ask",
      "tofu destroy*": "deny",
      // --- Rsync ---
      "rsync*": "ask",
      // --- Logs ---
      "dmesg*": "allow",
      "journalctl*": "allow",
      // --- Zellij ---
      "zellij*": "allow"
    },
    // --- FILE ACCESS DENY RULES ---
    // Block read/edit/glob/grep on sensitive paths (SSH keys, cloud credentials,
    // password managers, private keys, etc.). Last matching rule wins, so these
    // specific denies override the tool defaults even when a broad allow exists.
    // Covers both macOS and NixOS/Linux secret locations.
    // Gate anything OUTSIDE the project dir: keep the default "ask", deny secrets.
    "external_directory": {
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/**": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.kube/**": "deny",
      "~/.password-store/**": "deny",
      "~/.config/sops/**": "deny",
      "~/.local/share/keyrings/**": "deny",
      "~/Library/Keychains/**": "deny",
      "/etc/sops/**": "deny",
      "/etc/ssh/**": "deny",
      "*": "ask"
    },
    "read": {
      "*": "allow",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/**": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.kube/**": "deny",
      "~/.docker/config.json": "deny",
      "~/.netrc": "deny",
      "~/.password-store/**": "deny",
      "~/.config/opencode/auth*": "deny",
      "~/.config/sops/**": "deny",
      "~/.local/share/keyrings/**": "deny",
      "~/Library/Keychains/**": "deny",
      "/etc/sops/**": "deny",
      "/etc/ssh/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/secrets.json": "deny",
      "**/secrets.yaml": "deny",
      "**/secrets.yml": "deny"
    },
    "edit": {
      "*": "allow",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/**": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.kube/**": "deny",
      "~/.docker/config.json": "deny",
      "~/.netrc": "deny",
      "~/.password-store/**": "deny",
      "~/.config/opencode/auth*": "deny",
      "~/.config/sops/**": "deny",
      "~/.local/share/keyrings/**": "deny",
      "~/Library/Keychains/**": "deny",
      "/etc/sops/**": "deny",
      "/etc/ssh/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/secrets.json": "deny",
      "**/secrets.yaml": "deny",
      "**/secrets.yml": "deny"
    },
    "glob": {
      "*": "allow",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/**": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.kube/**": "deny",
      "~/.docker/config.json": "deny",
      "~/.netrc": "deny",
      "~/.password-store/**": "deny",
      "~/.config/opencode/auth*": "deny",
      "~/.config/sops/**": "deny",
      "~/.local/share/keyrings/**": "deny",
      "~/Library/Keychains/**": "deny",
      "/etc/sops/**": "deny",
      "/etc/ssh/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/secrets.json": "deny",
      "**/secrets.yaml": "deny",
      "**/secrets.yml": "deny"
    },
    "grep": {
      "*": "allow",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/**": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.kube/**": "deny",
      "~/.docker/config.json": "deny",
      "~/.netrc": "deny",
      "~/.password-store/**": "deny",
      "~/.config/opencode/auth*": "deny",
      "~/.config/sops/**": "deny",
      "~/.local/share/keyrings/**": "deny",
      "~/Library/Keychains/**": "deny",
      "/etc/sops/**": "deny",
      "/etc/ssh/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/secrets.json": "deny",
      "**/secrets.yaml": "deny",
      "**/secrets.yml": "deny"
    }
  }
}
