{
  // opencode.jsonc: Configuration for the OpenCode AI agent.
  // Native V2 field names (verified against opencode 2.2.3 + opencode.ai/v2/docs):
  // `providers`, `agents`, `permissions` array, `mcp.servers`, `compaction.keep`.
  "$schema": "https://opencode.ai/config.json",

  // --- MODEL SELECTION ---
  // Cloud-first default: Qwen3.8 Flash (best coding/reasoning tier, ~5400 req/5hr).
  // Bulk fallback when flash quota drains: DeepSeek V4.1 Flash (~43k req/5hr);
  // DeepSeek V4 Pro (~1k req/5hr) is a quality option, not a quota refuge.
  // GLM-5.3-flash stays wired to the `plan` agent for long-horizon precision work.
  // Titles/summaries ride the same paid flash tier as the default model (pinned
  // on the hidden `title`/`summary` agents below): cloud-backed and barely dents
  // the quota. V1's `small_model` field is gone.
  "model": "opencode-go/qwen3.8-flash",

  // Never offer session sharing — dotfiles sessions can leak host paths/context.
  // V1-compat carryover: still accepted by the V2 schema and absent from the
  // migration guide's "ignored fields" list; revisit if a release starts warning.
  "share": "disabled",

  // NOTE: no `providers` block needed — opencode-go models come from the
  // catalog once connected (/connect). Ollama is auto-discovered by the
  // built-in provider whenever its daemon runs; those models simply show up
  // in /models without any pinning here.
  "providers": {},

  // --- AGENTS ---
  // Per-agent model pinning: each kind of cloud work gets its own model
  // instead of one configuration for everything. V1's `agent` map, `prompt`,
  // and `permission` fields are gone — `system` and `permissions` replace
  // them, and titles/summaries are pinned on the hidden built-ins.
  "agents": {
    // Session titles ride the paid flash tier (replaces V1 root `small_model`).
    "title": {
      "model": "opencode-go/qwen3.8-flash"
    },
    // ...and so do session summaries, which V1's small_model did not cover.
    "summary": {
      "model": "opencode-go/qwen3.8-flash"
    },
    // Plan mode = long-horizon precision -> GLM-5.3-flash (best agentic quality).
    "plan": {
      "model": "opencode-go/glm-5.3-flash"
    }
  },

  // --- MCP SERVERS ---
  // Model Context Protocol servers provide additional tools (package search,
  // system info, etc.). Both are DISABLED by default. In V2 enabled servers are
  // routed through the Code Mode catalog (tools.<server>.<tool> behind the
  // `execute` tool) rather than the provider's native tool list — cheaper than
  // full JSON schemas, but they still grow every prompt's catalog and add
  // startup/connection overhead, so nothing is wired in unless it earns it.
  //
  // Enable on demand when you need specific MCP tools:
  //   brew: Package search/install for Homebrew (macOS)
  //   nixos: Package search for NixOS (Linux only)
  //
  // To enable, set "disabled": false and restart (or connect via /mcps).
  "mcp": {
    "servers": {
      "brew": {
        "type": "local",
        "command": ["brew", "mcp-server"],
        "disabled": true,
        "timeout": {
          "startup": 30000,
          "catalog": 30000,
          "execution": 30000
        }
      },
      // NixOS MCP only works on the NixOS machine. Re-enable there for package search.
      // On macOS, this will fail silently (nix command not found or wrong platform).
      "nixos": {
        "type": "local",
        "command": ["nix", "run", "github:utensils/mcp-nixos", "--"],
        "disabled": true,
        "timeout": {
          "startup": 30000,
          "catalog": 30000,
          "execution": 30000
        }
      }
    }
  },

  // --- COMPACTION ---
  // Context window management for long conversations. Auto-compaction summarizes
  // older turns to stay within model limits and reduce token costs.
  //
  // V2 dropped V1's `tail_turns` (it was silently ignored with a warning):
  // recent context is retained by token budget, not turn counts.
  //
  // keep.tokens: 8000 - Keep the most recent ~8k tokens intact when compacting
  // (roughly 4-5 turns). Balances context retention vs. compression ratio.
  // Lower than default to save cloud tokens on long sessions.
  //
  // buffer: 2048 - Reserve this many tokens for system prompts, tool catalogs,
  // and safety margin. Prevents "context too long" errors at the edge of the
  // limit. (V1 name: `reserved`.)
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 8000
    },
    "buffer": 2048
  },

  // --- EXPERIMENTAL ---
  // background_compaction: the summary is written ahead of need (in the
  // background) so automatic compaction doesn't pause the session. Opt-in per
  // V2 docs; experimental settings may change or vanish in any release.
  "experimental": {
    "background_compaction": true
  },

  // --- PERMISSIONS ---
  // One ordered array; LAST matching rule wins, so broad rules come first and
  // specific asks/denies after them (V1 grouped effects by tool under
  // `permission`; V2 action names: `bash` -> `shell`, `task` -> `subagent`,
  // `write`/`patch` are covered by `edit`).
  //
  // NOTE: `glob` and `grep` are intentionally absent. In V2 their resources are
  // the requested *patterns*, not file paths, so path-based secret denies there
  // were no-ops; secret paths stay gated by external_directory + read/edit.
  "permissions": [
    // --- SHELL: SYSTEM ---
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "sudo*", "effect": "ask" },
    { "action": "shell", "resource": "shutdown*", "effect": "deny" },
    { "action": "shell", "resource": "reboot*", "effect": "deny" },
    { "action": "shell", "resource": "halt*", "effect": "deny" },
    { "action": "shell", "resource": "dd*", "effect": "deny" },
    { "action": "shell", "resource": "mkfs*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf*", "effect": "deny" },
    { "action": "shell", "resource": "rm -fr*", "effect": "deny" },
    // -f alone just suppresses the prompt (plain rm is allowed anyway) -> ask.
    { "action": "shell", "resource": "rm -f*", "effect": "ask" },
    // Catch recursive deletes however the flags are spelled or ordered.
    // Must come after "rm -f*" so deny wins for combined cases (rm -f -r).
    { "action": "shell", "resource": "rm -r*", "effect": "deny" },
    { "action": "shell", "resource": "rm * -r*", "effect": "deny" },
    { "action": "shell", "resource": "rm --recursive*", "effect": "deny" },
    { "action": "shell", "resource": "topgrade*", "effect": "ask" },
    // --- SHELL: PROCESS MANAGEMENT ---
    { "action": "shell", "resource": "pkill*", "effect": "ask" },
    { "action": "shell", "resource": "killall*", "effect": "ask" },
    // --- SHELL: GIT ---
    { "action": "shell", "resource": "git commit*", "effect": "ask" },
    { "action": "shell", "resource": "git push*", "effect": "ask" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push -f*", "effect": "deny" },
    { "action": "shell", "resource": "git push --force-with-lease*", "effect": "ask" },
    { "action": "shell", "resource": "git merge*", "effect": "ask" },
    { "action": "shell", "resource": "git rebase*", "effect": "ask" },
    { "action": "shell", "resource": "git reset*", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
    { "action": "shell", "resource": "git checkout*", "effect": "ask" },
    { "action": "shell", "resource": "git restore*", "effect": "ask" },
    { "action": "shell", "resource": "git stash drop*", "effect": "ask" },
    { "action": "shell", "resource": "git stash clear*", "effect": "ask" },
    { "action": "shell", "resource": "git clean*", "effect": "ask" },
    { "action": "shell", "resource": "git clean -fd*", "effect": "deny" },
    { "action": "shell", "resource": "git clean -df*", "effect": "deny" },
    { "action": "shell", "resource": "git clean -fdx*", "effect": "deny" },
    { "action": "shell", "resource": "git clean -dx*", "effect": "deny" },
    { "action": "shell", "resource": "git clean -xd*", "effect": "deny" },
    { "action": "shell", "resource": "git clean -x*", "effect": "deny" },
    // --- SHELL: DOCKER ---
    { "action": "shell", "resource": "docker*", "effect": "allow" },
    { "action": "shell", "resource": "docker run*", "effect": "ask" },
    { "action": "shell", "resource": "docker rm*", "effect": "ask" },
    { "action": "shell", "resource": "docker rmi*", "effect": "ask" },
    { "action": "shell", "resource": "docker stop*", "effect": "ask" },
    { "action": "shell", "resource": "docker kill*", "effect": "ask" },
    { "action": "shell", "resource": "docker system prune*", "effect": "ask" },
    // --- SHELL: BREW ---
    { "action": "shell", "resource": "brew*", "effect": "allow" },
    { "action": "shell", "resource": "brew remove*", "effect": "ask" },
    { "action": "shell", "resource": "brew uninstall*", "effect": "ask" },
    { "action": "shell", "resource": "brew autoremove*", "effect": "ask" },
    // --- SHELL: NIX ---
    // "nix*" also matches nixos-rebuild, so it must come first, not last.
    { "action": "shell", "resource": "nix*", "effect": "allow" },
    { "action": "shell", "resource": "nix profile remove*", "effect": "ask" },
    { "action": "shell", "resource": "nixos-rebuild*", "effect": "ask" },
    { "action": "shell", "resource": "nix* delete*", "effect": "ask" },
    // --- SHELL: OPENTOFU ---
    // Broad "ask" first; the specific allows below must come after it.
    { "action": "shell", "resource": "tofu*", "effect": "ask" },
    { "action": "shell", "resource": "tofu init*", "effect": "allow" },
    { "action": "shell", "resource": "tofu plan*", "effect": "allow" },
    { "action": "shell", "resource": "tofu validate*", "effect": "allow" },
    { "action": "shell", "resource": "tofu apply*", "effect": "ask" },
    { "action": "shell", "resource": "tofu destroy*", "effect": "deny" },
    // --- SHELL: RSYNC ---
    { "action": "shell", "resource": "rsync*", "effect": "ask" },
    // --- SHELL: LOGS ---
    { "action": "shell", "resource": "dmesg*", "effect": "allow" },
    { "action": "shell", "resource": "journalctl*", "effect": "allow" },
    // --- SHELL: ZELLIJ ---
    { "action": "shell", "resource": "zellij*", "effect": "allow" },

    // --- FILE ACCESS: EXTERNAL DIRECTORIES ---
    // Gate anything OUTSIDE the project dir: keep the default "ask", deny secrets.
    // The broad "ask" goes FIRST here (it was last in the V1 map, which under
    // last-match-wins would have downgraded every secret deny back to ask).
    // Covers both macOS and NixOS/Linux secret locations.
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/.ssh/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.gnupg/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.aws/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.config/gcloud/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.kube/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.password-store/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.config/sops/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.local/share/keyrings/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/Library/Keychains/**", "effect": "deny" },
    { "action": "external_directory", "resource": "/etc/sops/**", "effect": "deny" },
    { "action": "external_directory", "resource": "/etc/ssh/**", "effect": "deny" },

    // --- FILE ACCESS: READ ---
    // `*` matches across `/` in V2, so `*.env`-style patterns cover nested AND
    // repo-root files (V1's `**/.env` form required a literal slash and missed
    // top-level .env/.pem/.key files).
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "~/.ssh/**", "effect": "deny" },
    { "action": "read", "resource": "~/.gnupg/**", "effect": "deny" },
    { "action": "read", "resource": "~/.aws/**", "effect": "deny" },
    { "action": "read", "resource": "~/.config/gcloud/**", "effect": "deny" },
    { "action": "read", "resource": "~/.kube/**", "effect": "deny" },
    { "action": "read", "resource": "~/.docker/config.json", "effect": "deny" },
    { "action": "read", "resource": "~/.netrc", "effect": "deny" },
    { "action": "read", "resource": "~/.password-store/**", "effect": "deny" },
    { "action": "read", "resource": "~/.config/opencode/auth*", "effect": "deny" },
    { "action": "read", "resource": "~/.config/sops/**", "effect": "deny" },
    { "action": "read", "resource": "~/.local/share/keyrings/**", "effect": "deny" },
    { "action": "read", "resource": "~/Library/Keychains/**", "effect": "deny" },
    { "action": "read", "resource": "/etc/sops/**", "effect": "deny" },
    { "action": "read", "resource": "/etc/ssh/**", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*secrets.json", "effect": "deny" },
    { "action": "read", "resource": "*secrets.yaml", "effect": "deny" },
    { "action": "read", "resource": "*secrets.yml", "effect": "deny" },

    // --- FILE ACCESS: EDIT (covers edit, write, and patch tools) ---
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "~/.ssh/**", "effect": "deny" },
    { "action": "edit", "resource": "~/.gnupg/**", "effect": "deny" },
    { "action": "edit", "resource": "~/.aws/**", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/gcloud/**", "effect": "deny" },
    { "action": "edit", "resource": "~/.kube/**", "effect": "deny" },
    { "action": "edit", "resource": "~/.docker/config.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.netrc", "effect": "deny" },
    { "action": "edit", "resource": "~/.password-store/**", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/opencode/auth*", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/sops/**", "effect": "deny" },
    { "action": "edit", "resource": "~/.local/share/keyrings/**", "effect": "deny" },
    { "action": "edit", "resource": "~/Library/Keychains/**", "effect": "deny" },
    { "action": "edit", "resource": "/etc/sops/**", "effect": "deny" },
    { "action": "edit", "resource": "/etc/ssh/**", "effect": "deny" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.pem", "effect": "deny" },
    { "action": "edit", "resource": "*.key", "effect": "deny" },
    { "action": "edit", "resource": "*secrets.json", "effect": "deny" },
    { "action": "edit", "resource": "*secrets.yaml", "effect": "deny" },
    { "action": "edit", "resource": "*secrets.yml", "effect": "deny" }
  ]
}
