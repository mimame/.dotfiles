# Ghostty Configuration File - Accessibility Optimized
# https://ghostty.org/docs/config/reference

# --- Accessibility & Visibility ---
# WCAG AA standard contrast (4.5) ensures text is always readable
minimum-contrast = 4.5
# Prevents text edge darkening/artifacts on Linux
alpha-blending = linear-corrected

# --- Typography ---
font-family = "Maple Mono NL NF"
font-family = "JetBrainsMonoNL Nerd Font Mono"
font-size = 18.0
# Disable all programming and standard ligatures
font-feature = -calt
font-feature = -liga
font-feature = -dlig

# --- Theme & Colors ---
theme = Dracula
# Solid, never-blinking cursor, easy to track (style block is the default)
cursor-style-blink = false

# --- Window & UI ---
# Prefer client-side decorations; the OS/WM may override (Niri draws its own chrome)
window-decoration = true
# Add padding so text doesn't hug the screen edges
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

# --- Productivity & Interaction ---
# Tab navigation via PageUp/PageDown (aligns with browser and mouse remapping)
keybind = ctrl+page_up=previous_tab
keybind = ctrl+page_down=next_tab
mouse-hide-while-typing = true
# Consistent scrolling speed (default only gives 3x to discrete wheels)
mouse-scroll-multiplier = 3
# Ensure new output is always visible
scroll-to-bottom = output
# Fine-grained control over working directory inheritance:
# - Windows start fresh in the home directory
# - Tabs and splits inherit the current directory for workflow continuity
window-inherit-working-directory = false

# --- Selection & Clipboard ---
# Copy selections to both the selection buffer and the system clipboard
copy-on-select = both
# Security: Disabled to prevent confirmation friction. Veteran Linux usage
# assumes manual buffer verification before pasting.
clipboard-paste-protection = false

# --- Shell & System ---
# Enables prompt marking, window titles, and SSH terminfo management
shell-integration-features = cursor,no-sudo,title,ssh-env,ssh-terminfo
# Disable built-in auto-update (macOS Sparkle) to maintain deterministic
# management via system package managers (Nix on NixOS, Homebrew on macOS).
auto-update = off

# --- Notifications ---
app-notifications = no-clipboard-copy
# Notify when a long-running command finishes
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s
